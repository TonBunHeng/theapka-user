# TheapKa User Portal Environment Configuration

# Backend API URL:
# For Local Development:
VITE_API_URL=http://localhost:8000

# For Vercel Production:
# Set VITE_API_URL in your Vercel Dashboard -> Project Settings -> Environment Variables
# Example: VITE_API_URL=https://your-api-domain.com

# Optional Google Identity Client ID
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
